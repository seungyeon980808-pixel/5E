{
  "name": "5e-desktop",
  "version": "1.5.3",
  "private": true,
  "description": "5E science diagram editor for Windows with a local Codex image assistant",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "node_modules\\electron\\dist\\electron.exe .",
    "test": "node desktop/run-unit-tests.cjs",
    "test:diagnostics": "node desktop/run-unit-tests.cjs --diagnostics",
    "test:desktop": "node desktop/run-smoke.cjs",
    "test:image": "set FIVE_E_IMAGE_E2E=1&& set FIVE_E_SMOKE_TIMEOUT=240000&& node desktop/run-smoke.cjs",
    "benchmark:image": "node desktop/benchmark-image-turn.cjs",
    "benchmark:scene": "node desktop/benchmark-scene-turn.cjs",
    "benchmark:scene:repeatability": "node desktop/benchmark-scene-repeatability.cjs",
    "verify:scene:repeatability": "node desktop/benchmark-scene-repeatability.cjs --verify",
    "benchmark:local-assets": "node desktop/benchmark-local-assets.cjs",
    "verify:local-assets": "node desktop/benchmark-local-assets.cjs --verify",
    "audit:exam-motifs": "node scripts/engine-v2/audit-exam-motifs.mjs --check",
    "setup:pdfjs": "node tools/pdf-library/setup-pdfjs.mjs",
    "setup:ocr": "node tools/pdf-library/setup-ocr.mjs",
    "candidate:build": "node tools/pdf-library/build-deployment-candidate.mjs",
    "candidate:verify": "node tools/pdf-library/verify-deployment-candidate.mjs",
    "candidate:serve": "node tools/pdf-library/serve-deployment-candidate.mjs",
    "package:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "tesseract.js": "7.0.0"
  },
  "build": {
    "appId": "com.5e.editor",
    "productName": "5E",
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "index.html",
      "manifest.json",
      "LICENSE",
      "css/**/*",
      "js/**/*",
      "vendor/ocr/**/*",
      "vendor/pdfjs/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/codex-turn-runtime.cjs",
      "desktop/codex-process-failure.cjs",
      "desktop/ai-thread-profile.cjs",
      "desktop/pdf-library-scanner.cjs",
      "desktop/pdf-library-service.cjs",
      "desktop/pdf-library-ipc.cjs",
      "desktop/splash.html",
      "assets/apple-touch-icon.png",
      "assets/favicon.png",
      "assets/icon-192.png",
      "assets/icon-512.png",
      "assets/icon.ico",
      "assets/logo.svg",
      "assets/og-image.png",
      "assets/svg_object/**/*",
      "assets/exam-library/manifest.json",
      "assets/exam-library/synonyms.json",
      "assets/exam-library/tag-vocab.json",
      "assets/exam-library/images/p2_2027_06_13.png",
      "assets/exam-parts/**/*",
      "assets/parts-library/manifest.json",
      "assets/parts-library/svg/**/*",
      "fonts/lmroman10-regular.woff2",
      "fonts/lmroman10-regular.otf",
      "fonts/lmroman10-italic.woff2",
      "fonts/lmroman10-italic.otf",
      "docs/credits.html",
      "!node_modules/@napi-rs/canvas-darwin-*/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  }
}
