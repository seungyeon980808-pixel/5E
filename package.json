{
  "name": "5e-desktop",
  "version": "1.5.3",
  "private": true,
  "description": "5E science diagram editor for Windows and macOS with a local Codex image assistant",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test": "node desktop/run-unit-tests.cjs",
    "test:diagnostics": "node desktop/run-unit-tests.cjs --diagnostics",
    "test:desktop": "node desktop/run-smoke.cjs",
    "test:image": "node desktop/run-smoke.cjs --image",
    "benchmark:image": "node desktop/benchmark-image-turn.cjs",
    "benchmark:scene": "node desktop/benchmark-scene-turn.cjs",
    "benchmark:scene:repeatability": "node desktop/benchmark-scene-repeatability.cjs",
    "verify:scene:repeatability": "node desktop/benchmark-scene-repeatability.cjs --verify",
    "benchmark:local-assets": "node desktop/benchmark-local-assets.cjs",
    "verify:local-assets": "node desktop/benchmark-local-assets.cjs --verify",
    "audit:exam-motifs": "node scripts/engine-v2/audit-exam-motifs.mjs --check",
    "package:win": "node tools/pdf-library/run-electron-builder.mjs --win --publish never",
    "package:mac": "node tools/pdf-library/run-electron-builder.mjs --mac --publish never",
    "test:editor": "node --test desktop/editor-clipboard.test.cjs desktop/image-clipboard.test.cjs desktop/platform-shortcuts.test.cjs desktop/mac-keyboard.test.cjs desktop/page-history.test.cjs desktop/document-history.test.cjs desktop/project-status.test.cjs desktop/project-load-stability.test.cjs desktop/autosave-stability.test.cjs tests/test-project-file-extension.mjs tests/test-ai-image-insertion.mjs",
    "test:tutorial": "node --test desktop/tutorial-engine.test.cjs desktop/tutorial-courses.test.cjs",
    "test:editor:browser": "node desktop/editor-usability-browser.cjs",
    "setup:pdfjs": "node tools/pdf-library/setup-pdfjs.mjs",
    "setup:ocr": "node tools/pdf-library/setup-ocr.mjs",
    "candidate:build": "node tools/pdf-library/build-deployment-candidate.mjs",
    "candidate:verify": "node tools/pdf-library/verify-deployment-candidate.mjs",
    "candidate:serve": "node tools/pdf-library/serve-deployment-candidate.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "tesseract.js": "7.0.0"
  },
  "build": {
    "appId": "com.5e.editor",
    "productName": "5E",
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "index.html",
      "manifest.json",
      "LICENSE",
      "css/**/*",
      "js/**/*",
      "experiments/web-codex-auth/editor-bridge.js",
      "vendor/ocr/**/*",
      "vendor/pdfjs/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/project-close-guard.cjs",
      "desktop/project-package.cjs",
      "desktop/project-package-signature.cjs",
      "desktop/project-package-zip.cjs",
      "desktop/windows-project-package.cjs",
      "desktop/project-open.cjs",
      "desktop/project-launcher/launcher",
      "desktop/project-launcher/BlueDocument.icns",
      "desktop/project-launcher/windows/launcher.exe",
      "desktop/project-launcher/windows/ThirdPartyNotices.txt",
      "desktop/codex-turn-runtime.cjs",
      "desktop/codex-process-failure.cjs",
      "desktop/fullscreen-state.cjs",
      "desktop/fullscreen-escape.cjs",
      "desktop/ai-thread-profile.cjs",
      "desktop/batch-output-service.cjs",
      "desktop/image-export-service.cjs",
      "desktop/pdf-library-scanner.cjs",
      "desktop/pdf-library-service.cjs",
      "desktop/pdf-library-ipc.cjs",
      "desktop/bundled-pdf-pack.cjs",
      "desktop/splash.html",
      "assets/apple-touch-icon.png",
      "assets/favicon.png",
      "assets/icon-192.png",
      "assets/icon-512.png",
      "assets/icon.ico",
      "assets/logo.svg",
      "assets/og-image.png",
      "assets/svg_object/**/*",
      "assets/exam-library/manifest.json",
      "assets/exam-library/synonyms.json",
      "assets/exam-library/tag-vocab.json",
      "assets/exam-library/sample-catalog.json",
      "assets/exam-library/images/p1_2025_11_05.png",
      "assets/exam-library/images/p1_2026_06_12.png",
      "assets/exam-library/images/p1_2026_09_01.png",
      "assets/exam-library/images/p1_2026_11_01.png",
      "assets/exam-library/images/p1_2026_11_08.png",
      "assets/exam-library/images/p1_2027_06_01.png",
      "assets/exam-library/images/p2_2027_06_13.png",
      "assets/pdf-library/google-drive.json",
      "assets/exam-parts/**/*",
      "assets/parts-library/manifest.json",
      "assets/parts-library/svg/**/*",
      "fonts/lmroman10-regular.woff2",
      "fonts/lmroman10-regular.otf",
      "fonts/lmroman10-italic.woff2",
      "fonts/lmroman10-italic.otf",
      "docs/credits.html",
      "!node_modules/@napi-rs/canvas-darwin-*/**/*"
    ],
    "extraResources": [{
      "from": "${env.FIVE_E_PDF_PACK_SOURCE}",
      "to": "pdf-library/recent-three-pack",
      "filter": ["**/*"]
    }],
    "win": {
      "icon": "assets/icon.ico",
      "fileAssociations": [{ "ext": "5e", "name": "5E 프로젝트", "icon": "desktop/project-launcher/windows/BlueDocument.ico" }],
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "mac": {
      "extendInfo": { "FIVEEDocumentLaunchVersion": 1 },
      "fileAssociations": [{ "ext": "5e", "name": "5E 프로젝트", "role": "Editor", "icon": "desktop/project-launcher/BlueDocument.icns" }],
      "icon": "assets/icon-512.png",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "nsis": { "include": "build/project-launcher.nsh", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  }
}
