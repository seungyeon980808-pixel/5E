{
  "name": "5e-desktop",
  "version": "1.6.0",
  "private": true,
  "description": "5E science diagram editor for Windows and macOS with a local Codex image assistant",
  "author": "박승연",
  "license": "AGPL-3.0",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "desktop": "electron .",
    "test": "npm run test:unit",
    "test:unit": "node desktop/run-unit-tests.cjs",
    "test:browser": "node tests/run-browser-tests.cjs",
    "test:smoke-contract": "node --test tests/test-smoke-gate-contract.cjs && node tests/run-browser-tests.cjs --only test-smoke-contract-browser.cjs",
    "verify:release-identity": "node scripts/check-release-identity.cjs",
    "build:unpacked": "electron-builder --dir --publish never",
    "test:desktop": "node desktop/run-smoke.cjs",
    "test:image": "node desktop/run-smoke.cjs --image",
    "audit:exam-motifs": "node scripts/engine-v2/audit-exam-motifs.mjs --check",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "package:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "com.5e.editor",
    "productName": "5E",
    "artifactName": "5E-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["index.html", "manifest.json", "LICENSE", "css/**/*", "js/**/*", "assets/**/*", "!assets/exam-library/**", "fonts/**/*", "preview/**/*", "desktop/**/*", "tests/fixtures/rights-clear-smoke.png", "docs/EXAM_SCIENTIFIC_DIAGRAM_STYLE.md", "docs/GPT_KNOWLEDGE_EVALUATION_SCIENCE_LINEART.md", "docs/IMAGE_COMPLEXITY_MODE_SPEC.md"],
    "win": { "icon": "assets/icon.ico", "artifactName": "5E-${version}-windows-${arch}.${ext}", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.education",
      "artifactName": "5E-${version}-macos-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
