{
  "name": "5e-memo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "esbuild worker/index.js --bundle --format=esm --platform=browser --outfile=../_work/memo-worker/index.js",
    "test": "node --test tests/*.test.mjs",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc",
    "deploy:worker": "node ../scripts/memo-worker-config.cjs && wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  }
}
