# Exam preview backgrounds — may contain third-party (e.g. KICE) copyrighted
# exam pages. Keep local; do NOT commit/deploy publicly. Swap for a self-made
# mock page before any public release.
assets/exam-backgrounds/

# 작업용 산출물(기출 PDF에서 뽑은 600dpi 도판 등) — 부품만 assets/exam-parts 로 옮긴다
_work/

# ----- 생성물: 도구로 다시 만들 수 있으므로 이력에 남기지 않는다 -----
# atlas-report*.html 는 tools/atlas-report.py 가 figure-atlas*.jsonl 에서 만든다.
# base64 이미지가 박혀 있어 둘이 합쳐 42MB — 한 번 커밋하면 이력에서 못 지운다.
docs/atlas-report*.html
docs/chem-parts-proposal.html

# 분해 작업 재개용 기록(진행 상태) — 결과는 figure-atlas*.jsonl 에 있다
docs/.atlas-done*.txt
docs/.atlas-plan.json

# 스크래치 — 검토용 임시 HTML·JSON
_repro/
_sheet.html
scratch_*.json

# .claude/skills 는 .agents/skills 를 가리키는 **절대경로 심볼릭 링크**라
# 다른 컴퓨터에서 깨진다. 실체(.agents/skills)만 커밋한다.
.claude/skills/

__pycache__/

