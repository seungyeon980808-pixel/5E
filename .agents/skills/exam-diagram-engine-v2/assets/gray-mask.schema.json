{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "parent_attempt", "regions"],
  "properties": {
    "case_id": {"type": "string"},
    "parent_attempt": {"type": "integer", "minimum": 1},
    "regions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "boxes"],
        "properties": {
          "name": {"type": "string"},
          "boxes": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}},
          "flat_gray": {"type": "integer", "minimum": 128, "maximum": 235}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
