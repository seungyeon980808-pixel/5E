{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://5e.local/schemas/exam-diagram-engine-v2-request.json",
  "title": "Exam diagram engine V2 analyzed request",
  "type": "object",
  "required": [
    "case_id", "input_mode", "subject", "description", "objects",
    "connections", "layout", "scientific_invariants", "allowed_gray_regions",
    "category_encoding", "forbidden"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "input_mode": {"enum": ["reference_image", "description_only", "sketch_plus_description"]},
    "subject": {"enum": ["physics", "chemistry", "biology", "earth_science"]},
    "description": {"type": "string", "minLength": 10},
    "source_images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["full_composition", "detail_crop", "sketch"]}
        },
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "count", "panel", "bbox"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 1},
          "panel": {"type": "integer", "minimum": 1},
          "bbox": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "cropped_edges": {
            "type": "array", "uniqueItems": true,
            "items": {"enum": ["top", "right", "bottom", "left"]}
          },
          "details": {"type": "array", "items": {"type": "string"}}
          ,"terminals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "from_terminal": {"type": "string"},
          "to_terminal": {"type": "string"},
          "kind": {"enum": ["wire", "tube", "string", "continuous_path", "contained_by", "supported_by", "touching", "adjacent", "not_connected"]},
          "details": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "required": ["canvas", "panel_count", "empty_regions"],
      "properties": {
        "canvas": {"enum": ["square", "landscape", "portrait"]},
        "panel_count": {"type": "integer", "minimum": 1},
        "empty_regions": {"type": "array", "items": {"type": "string"}},
        "overlap_order": {"type": "array", "items": {"type": "string"}},
        "minimum_margin_fraction": {"type": "number", "minimum": 0, "maximum": 0.25}
      },
      "additionalProperties": false
    },
    "scientific_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "allowed_gray_regions": {"type": "array", "items": {"type": "string"}},
    "category_encoding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "encoding"],
        "properties": {
          "category": {"type": "string"},
          "encoding": {"type": "string", "enum": ["outline", "solid_black", "flat_gray", "distinct_shape", "solid_line", "dashed_line"]}
        },
        "additionalProperties": false
      }
    },
    "state_variables": {"type": "array", "items": {"type": "string"}},
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "severity", "status"],
        "properties": {
          "question": {"type": "string"},
          "severity": {"enum": ["minor", "critical"]},
          "status": {"enum": ["resolved", "unresolved"]},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "conflict_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sketch", "description", "resolution", "reason"],
        "properties": {
          "sketch": {"type": "string"},
          "description": {"type": "string"},
          "resolution": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
