{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://5e.local/schemas/exam-diagram-engine-v2-evaluation.json",
  "type": "object",
  "required": ["case_id", "attempt", "engine_version", "scores", "hard_gates", "failure_tags", "evidence"],
  "properties": {
    "case_id": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "engine_version": {"type": "string"},
    "output": {"type": "string"},
    "scores": {
      "type": "object",
      "required": ["core_structure", "scientific_accuracy", "proportion_layout", "kice_lineart", "restrained_gray", "no_forbidden_marks", "editability"],
      "properties": {
        "core_structure": {"type": "number", "minimum": 0, "maximum": 25},
        "scientific_accuracy": {"type": "number", "minimum": 0, "maximum": 20},
        "proportion_layout": {"type": "number", "minimum": 0, "maximum": 15},
        "kice_lineart": {"type": "number", "minimum": 0, "maximum": 15},
        "restrained_gray": {"type": "number", "minimum": 0, "maximum": 10},
        "no_forbidden_marks": {"type": "number", "minimum": 0, "maximum": 10},
        "editability": {"type": "number", "minimum": 0, "maximum": 5}
      },
      "additionalProperties": false
    },
    "hard_gates": {
      "type": "object",
      "required": ["severe_science_error", "forbidden_mark_count", "unlisted_object_count", "critical_structure_broken", "category_encoding_valid"],
      "properties": {
        "severe_science_error": {"type": "boolean"},
        "forbidden_mark_count": {"type": "integer", "minimum": 0},
        "unlisted_object_count": {"type": "integer", "minimum": 0},
        "critical_structure_broken": {"type": "boolean"},
        "category_encoding_valid": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "failure_tags": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "generator": {"type": "string"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
