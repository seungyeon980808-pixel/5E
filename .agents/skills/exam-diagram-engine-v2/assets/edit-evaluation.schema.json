{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "attempt", "subject", "operations", "scores", "hard_gates", "failure_tags", "evidence"],
  "properties": {
    "case_id": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "subject": {"enum": ["physics", "chemistry", "biology", "earth_science"]},
    "operations": {"type": "array", "items": {"enum": ["style_cleanup", "move", "resize", "reorder", "duplicate", "delete", "replace_state", "connect", "disconnect"]}},
    "scores": {
      "type": "object",
      "required": ["core_structure", "scientific_accuracy", "proportion_layout", "kice_lineart", "restrained_gray", "no_forbidden_marks", "editability"]
    },
    "hard_gates": {
      "type": "object",
      "required": ["requested_changes_complete", "locked_invariants_preserved", "severe_science_error", "forbidden_mark_count", "unlisted_object_count", "critical_structure_broken"]
    },
    "failure_tags": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
